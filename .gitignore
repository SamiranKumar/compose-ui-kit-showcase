# -----------------------------
# 🧠 Android Studio / IntelliJ
# -----------------------------
.idea/              # IDE config files (auto-generated, don't commit)
*.iml               # Module files

# -----------------------------
# ⚙️ Gradle
# -----------------------------
.gradle/            # Gradle cache
build/              # Build output (all modules)

# -----------------------------
# 📱 Local configuration
# -----------------------------
local.properties    # SDK path (machine-specific, never commit)

# -----------------------------
# 🖥️ OS files
# -----------------------------
.DS_Store           # macOS system file

# -----------------------------
# 📸 Generated / temporary files
# -----------------------------
captures/           # Screenshots / recordings from Android Studio

# -----------------------------
# 🧩 Native build (NDK / C++)
# -----------------------------
.externalNativeBuild/   # Native build output
.cxx/                  # CMake build files